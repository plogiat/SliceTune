{
  "name": "slicetune",
  "version": "0.1.1",
  "description": "SliceTune — a bilingual multitrack audio editor for Windows",
  "author": "SliceTune contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/plogiat/SliceTune.git"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "vite build",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis zip --publish never",
    "dist:zip": "npm run build && electron-builder --win zip --publish never"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "lucide": "0.468.0",
    "soundtouchjs": "0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "8.3.6"
  },
  "build": {
    "appId": "io.slicetune.editor",
    "productName": "SliceTune",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/@ffmpeg-installer/linux-*/**/*",
      "!node_modules/@ffmpeg-installer/darwin-*/**/*"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "docs/icon.ico",
      "signExecutable": false,
      "artifactName": "SliceTune-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "SliceTune-${version}-Setup-${arch}.${ext}"
    }
  },
  "type": "module"
}
